#pragma once

/**
 * @file version.hpp
 * @brief SDK and protocol versions. Generated by CMake from project(VERSION).
 */

#include "infrabot/protocol.h"

#define INFRABOT_SDK_VERSION_MAJOR @PROJECT_VERSION_MAJOR@  ///< SDK major version.
#define INFRABOT_SDK_VERSION_MINOR @PROJECT_VERSION_MINOR@  ///< SDK minor version.
#define INFRABOT_SDK_VERSION_PATCH @PROJECT_VERSION_PATCH@  ///< SDK patch version.

namespace infrabot {
inline constexpr char kSdkVersion[] = "@PROJECT_VERSION@";               ///< SDK version, e.g. "0.2.0".
inline constexpr uint16_t kProtocolMajor = INFRABOT_PROTOCOL_MAJOR;  ///< Protocol major the SDK speaks; must match the controller's.
inline constexpr uint16_t kProtocolMinor = INFRABOT_PROTOCOL_MINOR;  ///< Protocol minor the SDK speaks.
}  // namespace infrabot
